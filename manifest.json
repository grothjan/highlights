{
  "manifest_version": 3,
  "name": "Highlights",
  "version": "0.1.0",
  "description": "Highlight quotes on a page in pastel colors and review them in a compact panel.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "action": {
    "default_title": "Highlights — click to activate on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
